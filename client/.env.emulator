# Режим для E2E: приложение говорит с локальными эмуляторами Firebase.
#
# Файл коммитится намеренно — настоящих ключей здесь нет и быть не может.
# Эмулятор не проверяет ни ключ, ни домен, поэтому значения ниже
# демонстрационные; при этом без них Firebase SDK не инициализируется.
#
# Запуск: npm run dev:emulator (порт 5174, чтобы не мешать обычному npm run dev)

VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=askesis-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=askesis-web
VITE_FIREBASE_STORAGE_BUCKET=askesis-web.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

VITE_USE_FIREBASE_EMULATORS=true

# ИИ-воркер в E2E не участвует: сценарии не должны зависеть от внешней
# модели и тратить её квоту.
VITE_AI_WORKER_URL=
