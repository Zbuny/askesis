rules_version = '2';

// Cloud Functions недоступны на Spark-плане, поэтому клиент работает
// с Firestore напрямую — все проверки прав живут здесь.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/settings/admins) &&
        request.auth.uid in get(/databases/$(database)/documents/settings/admins).data.uids;
    }

    // Бутстрап первого админа: пока список пуст (или документа нет),
    // любой залогиненный пользователь может назначить СЕБЯ единственным
    // админом. После этого список меняют только текущие админы.
    match /settings/admins {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uids is list
        && request.resource.data.uids == [request.auth.uid];
      allow update: if isAdmin()
        || (resource.data.uids.size() == 0 && request.resource.data.uids == [request.auth.uid]);
      allow delete: if false;
    }

    // Библиотека упражнений и программы — читают все, пишет только админ
    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Тренировки и лог выполнения — доступны только владельцу
    match /workouts/{workoutId} {
      allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /workoutLogs/{logId} {
      allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Личные данные пользователя (вес, рост, возраст) — доступны только владельцу
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
